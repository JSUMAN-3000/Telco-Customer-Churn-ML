
{
  "family": "customer-churn-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::058190633843:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "customer-churn-container",
      "image": "058190633843.dkr.ecr.ap-south-2.amazonaws.com/customer-churn-ml:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/customer-churn",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
